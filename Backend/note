//PATCH /API/NOTES/:id denge 
// update the description of the note with the given id 
//req.body = {description}
app.patch("/api/notes/:id", async (req, res) => {
    //again id lelo params se
     const id = req.params.id
//destructuring se description leleo req.body mein so that usko update akrna hoga same in dukan first dukan take the object which they have to update 

     const { description } = req.body
     //now another thing
     await noteModel.findByIdAndUpdate(id, { description })

     res.status(200).json({
        message: "note is updated now"
     })
}

)

